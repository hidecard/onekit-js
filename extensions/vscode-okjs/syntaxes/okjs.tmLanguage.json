{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OneKit OKJS",
  "scopeName": "source.okjs",
  "patterns": [
    { "include": "#script-block" },
    { "include": "#template-block" },
    { "include": "#style-block" },
    { "include": "#html-tags" },
    { "include": "#directives" }
  ],
  "repository": {
    "script-block": {
      "name": "meta.block.script.okjs",
      "begin": "(<)(script)(\\b[^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.okjs" },
        "2": { "name": "entity.name.tag.script.okjs" },
        "3": { "name": "entity.other.attribute-name.okjs" },
        "4": { "name": "punctuation.definition.tag.end.okjs" }
      },
      "end": "(</)(script)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.okjs" },
        "2": { "name": "entity.name.tag.script.okjs" },
        "3": { "name": "punctuation.definition.tag.end.okjs" }
      },
      "contentName": "meta.embedded.block.typescript",
      "patterns": [{ "include": "source.ts" }]
    },
    "template-block": {
      "name": "meta.block.template.okjs",
      "begin": "(<)(template)(\\b[^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.okjs" },
        "2": { "name": "entity.name.tag.template.okjs" },
        "3": { "name": "entity.other.attribute-name.okjs" },
        "4": { "name": "punctuation.definition.tag.end.okjs" }
      },
      "end": "(</)(template)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.okjs" },
        "2": { "name": "entity.name.tag.template.okjs" },
        "3": { "name": "punctuation.definition.tag.end.okjs" }
      },
      "contentName": "meta.embedded.block.html",
      "patterns": [
        { "include": "text.html.basic" },
        { "include": "#directives" },
        { "include": "#interpolation" }
      ]
    },
    "style-block": {
      "name": "meta.block.style.okjs",
      "begin": "(<)(style)(\\b[^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.okjs" },
        "2": { "name": "entity.name.tag.style.okjs" },
        "3": { "name": "entity.other.attribute-name.okjs" },
        "4": { "name": "punctuation.definition.tag.end.okjs" }
      },
      "end": "(</)(style)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.okjs" },
        "2": { "name": "entity.name.tag.style.okjs" },
        "3": { "name": "punctuation.definition.tag.end.okjs" }
      },
      "contentName": "meta.embedded.block.css",
      "patterns": [{ "include": "source.css" }]
    },
    "html-tags": {
      "match": "</?[A-Za-z][A-Za-z0-9-]*(?=\\s|/?>)",
      "name": "entity.name.tag.html.okjs"
    },
    "directives": {
      "match": "\\b(ok-(?:if|else|for|bind|on|model|show|class|text|html)(?:\\.[A-Za-z-]+)?)\\b",
      "captures": {
        "1": { "name": "entity.other.attribute-name.directive.okjs" }
      }
    },
    "interpolation": {
      "begin": "\\{\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.okjs" } },
      "end": "\\}\\}",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.okjs" } },
      "contentName": "meta.embedded.expression.okjs",
      "patterns": [{ "include": "source.ts" }]
    }
  }
}
