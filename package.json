{
  "name": "onekit-js",
  "version": "3.1.17",
  "description": "A compact reactive JavaScript framework with components, stores, SSR, JSX, templates, and a practical CLI.",
  "type": "module",
  "main": "dist/onekit.cjs",
  "module": "dist/onekit.esm.js",
  "browser": "dist/onekit.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "onekit": "bin/onekit.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/onekit.esm.js",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./components": {
      "types": "./dist/types/modules/component.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./reactive": {
      "types": "./dist/types/modules/reactive.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./store": {
      "types": "./dist/types/modules/store.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./query": {
      "types": "./dist/types/modules/query.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./forms": {
      "types": "./dist/types/modules/forms.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./ssr": {
      "types": "./dist/types/modules/ssr.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./head": {
      "types": "./dist/types/modules/head.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./template": {
      "types": "./dist/types/modules/template.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./testing": {
      "types": "./dist/types/testing.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./okjs": {
      "types": "./dist/types/okjs.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./jsx": {
      "types": "./dist/types/modules/jsx.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./jsx-runtime": {
      "types": "./dist/types/jsx-runtime.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./router": {
      "types": "./dist/types/modules/router.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./animation": {
      "types": "./dist/types/modules/animation.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./api": {
      "types": "./dist/types/modules/api.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./a11y": {
      "types": "./dist/types/modules/a11y.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./storage": {
      "types": "./dist/types/modules/storage.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./ergonomics": {
      "types": "./dist/types/modules/ergonomics.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./web-components": {
      "types": "./dist/types/modules/web-components.d.ts",
      "import": "./dist/onekit.esm.js",
      "require": "./dist/onekit.cjs"
    },
    "./vite": {
      "types": "./dist/types/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./cli/create": "./lib/cli/create.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "lib",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION_GUIDE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-library.mjs && npm run build:vite-plugin",
    "build:vite-plugin": "node scripts/build-vite-plugin.mjs",
    "benchmark": "npm run build && node scripts/benchmark-v3.mjs",
    "dev": "rollup -c -w",
    "dev:vite": "vite",
    "docs:dev": "vite --config examples/docs/vite.config.ts",
    "docs:build": "vite build --config examples/docs/vite.config.ts",
    "cli": "node ./bin/onekit.js",
    "test": "jest --config jest.config.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "verify:declarations": "node scripts/verify-declarations.mjs",
    "verify:hmr": "npm run build && node scripts/verify-hmr.mjs",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run type-check && npm test -- --runInBand && npm run build && npm run verify:declarations && npm run verify:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hidecard/onekit-js.git"
  },
  "author": "Arkar Yan",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "rollup": "^4.53.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "bugs": {
    "url": "https://github.com/hidecard/onekit-js/issues"
  },
  "homepage": "https://github.com/hidecard/onekit-js#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "rollup": "^4.53.3",
    "ts-jest": "^29.4.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
