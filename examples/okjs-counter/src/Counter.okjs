  margin: 0;
  color: #5757d5;
  font-size: .78rem;
  font-weight: 800;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.count {
  display: block;
  margin: 1.5rem 0;
  font-size: 4rem;
  font-variant-numeric: tabular-nums;
  font-weight: 800;
}

.step-control {
  display: inline-flex;
  gap: .5rem;
  align-items: center;
  color: #5b6478;
}

.step-control input {
  width: 4rem;
  padding: .45rem;
  border: 1px solid #c7d0ef;
  border-radius: .5rem;
}

.actions {
  display: flex;
  gap: .65rem;
  justify-content: center;
  margin: 1.5rem 0 2rem;
}

button {
  min-width: 3rem;
  padding: .7rem 1rem;
  color: white;
  font: inherit;
  font-weight: 700;
  background: #5757d5;
  border: 0;
  border-radius: .6rem;
  cursor: pointer;
}

button:hover { background: #4141b5; }

.history {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: .4rem;
  padding: 0;
  margin: 0;
  list-style: none;
}

.history li {
  padding: .45rem .25rem;
  color: #4d5780;
  background: #eef2ff;
  border-radius: .4rem;
}
</style>
